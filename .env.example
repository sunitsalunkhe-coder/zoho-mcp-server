# Zoho OAuth (India DC)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://your-domain.com/oauth/callback
ZOHO_DC=in
ZOHO_SCOPES=ZohoMail.messages.ALL,ZohoMail.accounts.READ,ZohoMail.folders.ALL,ZohoMail.attachments.ALL

# Token Storage
TOKEN_ENCRYPTION_KEY=  # 32-byte hex — generate: openssl rand -hex 32
TOKEN_STORE_PATH=./data/tokens.enc

# Server
PORT=3000
MCP_TRANSPORT=stdio  # stdio | http

# Logging
LOG_LEVEL=info
NODE_ENV=production
